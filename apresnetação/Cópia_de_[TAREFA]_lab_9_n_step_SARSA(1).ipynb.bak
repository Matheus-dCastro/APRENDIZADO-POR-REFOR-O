      "source": [
        "n_steps_list = [1, 2, 4, 8, 16]\n",
        "histories_n_steps = {}\n",
        "results_n_steps = []\n",
        "\n",
        "for n in n_steps_list:\n",
        "    label = f\"n = {n}\"\n",
        "    params_exp = params._replace(n_steps=n)\n",
        "    agent_exp = NStepSarsaAgent(params_exp)\n",
        "    env_exp = make_env()\n",
        "    history_exp = train_agent(agent_exp, env_exp, params_exp.n_episodes)\n",
        "    histories_n_steps[label] = history_exp\n",
        "\n",
        "    eval_series = evaluate_policy(agent_exp)\n",
        "    states, actions, rewards = simulate_trajectory(agent_exp, ENV_ID)\n",
        "    plot_trajectory(ENV_ID, states, title=f\"Trajetória gulosa ({label}): {len(actions)} passos, recompensa {sum(rewards):.0f}\")\n",
        "\n",
        "    n_truncated = sum(1 for s in history_exp.successes if s == 0)\n",
        "    results_n_steps.append({\n",
        "        \"n_steps\": n,\n",
        "        \"truncados no treinamento\": n_truncated,\n",
        "        \"chegada ao alvo\": eval_series[\"chegada ao alvo\"],\n",
        "        \"recompensa total média\": eval_series[\"recompensa total média\"],\n",
        "        \"duração média\": eval_series[\"duração média\"],\n",
        "    })\n",
        "\n",
        "plot_comparison(histories_n_steps, metric=\"returns\", title=\"Retorno médio por episódio para diferentes valores de n\")\n",
        "plot_comparison(histories_n_steps, metric=\"lengths\", title=\"Duração média por episódio para diferentes valores de n\")\n",
        "\n",
        "df_table_n = pd.DataFrame(results_n_steps)\n",
        "display(df_table_n)\n"
      ],
      "execution_count": null,
