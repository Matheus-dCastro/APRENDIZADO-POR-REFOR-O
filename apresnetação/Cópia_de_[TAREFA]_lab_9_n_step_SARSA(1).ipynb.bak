              "          <i class=\"fa fa-pause\"></i></button>\n",
              "      <button title=\"Play\" aria-label=\"Play\" onclick=\"animf72bbd348d854c498603d1f019548ca7.play_animation()\">\n",
              "          <i class=\"fa fa-play\"></i></button>\n",
              "      <button title=\"Next frame\" aria-label=\"Next frame\" onclick=\"animf72bbd348d854c498603d1f019548ca7.next_frame()\">\n",
              "          <i class=\"fa fa-step-forward\"></i></button>\n",
              "      <button title=\"Last frame\" aria-label=\"Last frame\" onclick=\"animf72bbd348d854c498603d1f019548ca7.last_frame()\">\n",
              "          <i class=\"fa fa-fast-forward\"></i></button>\n",
              "      <button title=\"Increase speed\" aria-label=\"Increase speed\" onclick=\"animf72bbd348d854c498603d1f019548ca7.faster()\">\n",
              "          <i class=\"fa fa-plus\"></i></button>\n",
              "    </div>\n",
              "    <form title=\"Repetition mode\" aria-label=\"Repetition mode\" action=\"#n\" name=\"_anim_loop_selectf72bbd348d854c498603d1f019548ca7\"\n",
              "          class=\"anim-state\">\n",
              "      <input type=\"radio\" name=\"state\" value=\"once\" id=\"_anim_radio1_f72bbd348d854c498603d1f019548ca7\"\n",
              "             checked>\n",
              "      <label for=\"_anim_radio1_f72bbd348d854c498603d1f019548ca7\">Once</label>\n",
              "      <input type=\"radio\" name=\"state\" value=\"loop\" id=\"_anim_radio2_f72bbd348d854c498603d1f019548ca7\"\n",
              "             >\n",
              "      <label for=\"_anim_radio2_f72bbd348d854c498603d1f019548ca7\">Loop</label>\n",
              "      <input type=\"radio\" name=\"state\" value=\"reflect\" id=\"_anim_radio3_f72bbd348d854c498603d1f019548ca7\"\n",
              "             >\n",
              "      <label for=\"_anim_radio3_f72bbd348d854c498603d1f019548ca7\">Reflect</label>\n",
              "    </form>\n",
              "  </div>\n",
              "</div>\n",
              "\n",
              "\n",
