              "          <i class=\"fa fa-minus\"></i></button>\n",
              "      <button title=\"First frame\" aria-label=\"First frame\" onclick=\"animf72bbd348d854c498603d1f019548ca7.first_frame()\">\n",
              "        <i class=\"fa fa-fast-backward\"></i></button>\n",
