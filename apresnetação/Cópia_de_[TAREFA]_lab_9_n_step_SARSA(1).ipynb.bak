s9-Regular-4d\" transform=\"translate(358.299637 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-62\" transform=\"translate(411.399582 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-1c\" transform=\"translate(450.799545 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-62\" transform=\"translate(500.199493 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-67\" transform=\"translate(539.599457 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-1c\" transform=\"translate(573.899429 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-69\" transform=\"translate(623.299377 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-fb\" transform=\"translate(660.399338 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-67\" transform=\"translate(706.099289 0.59375)\"/>\n     <use xlink:href=\"#Cmmi10-84\" transform=\"translate(740.399261 0.59375)\"/>\n     <use xlink:href=\"#Cmmi10-78\" transform=\"translate(785.516449 -14.406212) scale(0.7)\"/>\n    </g>\n   </g>\n   <g id=\"text_45\">\n    <!-- $\\times \\gamma^{T-t-1}$ -->\n    <g style=\"fill: #0095db\" transform=\"translate(473.350162 612.766516) scale(0.17 -0.17)\">\n     <use xlink:href=\"#Cmsy10-d\" transform=\"translate(0 0.892016)\"/>\n     <use xlink:href=\"#Cmmi10-18\" transform=\"translate(77.685547 0.892016)\"/>\n     <use xlink:href=\"#Cmmi10-78\" transform=\"translate(140.654713 42.18125) scale(0.7)\"/>\n     <use xlink:href=\"#Cmsy10-11\" transform=\"translate(195.533659 42.18125) scale(0.7)\"/>\n     <use xlink:href=\"#Cmmi10-30\" transform=\"translate(263.913582 42.18125) scale(0.7)\"/>\n     <use xlink:href=\"#Cmsy10-11\" transform=\"translate(303.172411 42.18125) scale(0.7)\"/>\n     <use xlink:href=\"#Cmr10-64\" transform=\"translate(371.552334 42.18125) scale(0.7)\"/>\n    </g>\n   </g>\n   <g id=\"text_46\">\n    <!-- estimativa -->\n    <g style=\"fill: #ff0000\" transform=\"translate(590.09155 507.913838) scale(0.14 -0.14)\">\n     <use xlink:href=\"#LMSans9-Regular-32\"/>\n     <use xlink:href=\"#LMSans9-Regular-62\" transform=\"translate(45.703125 0)\"/>\n     <use xlink:href=\"#LMSans9-Regular-69\" transform=\"translate(85.109375 0)\"/>\n     <use xlink:href=\"#LMSans9-Regular-42\" transform=\"translate(122.203125 0)\"/>\n     <use xlink:href=\"#LMSans9-Regular-4b\" transform=\"translate(146.703125 0)\"/>\n     <use xlink:href=\"#LMSans9-Regular-1c\" transform=\"translate(228.296875 0)\"/>\n     <use xlink:href=\"#LMSans9-Regular-69\" transform=\"translate(277.703125 0)\"/>\n     <use xlink:href=\"#LMSans9-Regular-42\" transform=\"translate(314.796875 0)\"/>\n     <use xlink:href=\"#LMSans9-Regular-70\" transform=\"translate(339.296875 0)\"/>\n     <use xlink:href=\"#LMSans9-Regular-1c\" transform=\"translate(386.703125 0)\"/>\n    </g>\n   </g>\n   <g id=\"text_47\">\n    <!-- $\\times \\gamma^{T-t}$ -->\n    <g style=\"fill: #ff0000\" transform=\"translate(595.544206 612.766516) scale(0.17 -0.17)\">\n     <use xlink:href=\"#Cmsy10-d\" transform=\"translate(0 0.892016)\"/>\n     <use xlink:href=\"#Cmmi10-18\" transform=\"translate(77.685547 0.892016)\"/>\n     <use xlink:href=\"#Cmmi10-78\" transform=\"translate(140.654713 42.18125) scale(0.7)\"/>\n     <use xlink:href=\"#Cmsy10-11\" transform=\"translate(195.533659 42.18125) scale(0.7)\"/>\n     <use xlink:href=\"#Cmmi10-30\" transform=\"translate(263.913582 42.18125) scale(0.7)\"/>\n    </g>\n   </g>\n   <g id=\"text_48\">\n    <!-- $\\bar q_t^{(n)} = r_{t+1} + \\gamma\\, r_{t+2} + \\cdots + \\gamma^{T-t-1} r_T + \\gamma^{T-t}\\, q(s_T,a_T)$ -->\n    <g style=\"fill: #ff0000\" transform=\"translate(170.022996 655.969278) scale(0.21 -0.21)\">\n     <use xlink:href=\"#Cmr10-83\" transform=\"translate(1.535156 1.727448)\"/>\n     <use xlink:href=\"#Cmmi10-52\" transform=\"translate(0 0.555573)\"/>\n     <use xlink:href=\"#Cmr10-77\" transform=\"translate(48.584369 52.5) scale(0.7)\"/>\n     <use xlink:href=\"#Cmmi10-7a\" transform=\"translate(75.757221 52.5) scale(0.7)\"/>\n     <use xlink:href=\"#Cmr10-44\" transform=\"translate(117.764056 52.5) scale(0.7)\"/>\n     <use xlink:href=\"#Cmmi10-30\" transform=\"translate(48.584369 -33.815625) scale(0.7)\"/>\n     <use xlink:href=\"#Cmr10-29\" transform=\"translate(170.657381 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-84\" transform=\"translate(268.342985 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-30\" transform=\"translate(313.460172 -14.444389) scale(0.7)\"/>\n     <use xlink:href=\"#Cmr10-4c\" transform=\"translate(352.719001 -14.444389) scale(0.7)\"/>\n     <use xlink:href=\"#Cmr10-64\" transform=\"translate(421.098924 -14.444389) scale(0.7)\"/>\n     <use xlink:href=\"#Cmr10-4c\" transform=\"translate(481.819397 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-18\" transform=\"translate(579.505001 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-84\" transform=\"translate(647.881033 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-30\" transform=\"translate(692.998221 -14.444389) scale(0.7)\"/>\n     <use xlink:href=\"#Cmr10-4c\" transform=\"translate(732.25705 -14.444389) scale(0.7)\"/>\n     <use xlink:href=\"#Cmr10-31\" transform=\"translate(800.636973 -14.444389) scale(0.7)\"/>\n     <use xlink:href=\"#Cmr10-4c\" transform=\"translate(861.357445 0.555573)\"/>\n     <use xlink:href=\"#STIXGeneral-Regular-502\" transform=\"translate(959.043049 0.555573)\"/>\n     <use xlink:href=\"#Cmr10-4c\" transform=\"translate(1071.643021 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-18\" transform=\"translate(1169.328625 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-78\" transform=\"translate(1232.297792 41.844807) scale(0.7)\"/>\n     <use xlink:href=\"#Cmsy10-11\" transform=\"translate(1287.176738 41.844807) scale(0.7)\"/>\n     <use xlink:href=\"#Cmmi10-30\" transform=\"translate(1355.556661 41.844807) scale(0.7)\"/>\n     <use xlink:href=\"#Cmsy10-11\" transform=\"translate(1394.81549 41.844807) scale(0.7)\"/>\n     <use xlink:href=\"#Cmr10-64\" transform=\"translate(1463.195413 41.844807) scale(0.7)\"/>\n     <use xlink:href=\"#Cmmi10-84\" transform=\"translate(1503.915828 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-78\" transform=\"translate(1549.033016 -14.444389) scale(0.7)\"/>\n     <use xlink:href=\"#Cmr10-4c\" transform=\"translate(1615.632395 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-18\" transform=\"translate(1713.317999 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-78\" transform=\"translate(1776.287165 41.844807) scale(0.7)\"/>\n     <use xlink:href=\"#Cmsy10-11\" transform=\"translate(1831.166111 41.844807) scale(0.7)\"/>\n     <use xlink:href=\"#Cmmi10-30\" transform=\"translate(1899.546034 41.844807) scale(0.7)\"/>\n     <use xlink:href=\"#Cmmi10-52\" transform=\"translate(1947.192286 0.555573)\"/>\n     <use xlink:href=\"#Cmr10-77\" transform=\"translate(1991.772364 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-58\" transform=\"translate(2030.590724 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-78\" transform=\"translate(2077.368068 -14.444389) scale(0.7)\"/>\n     <use xlink:href=\"#Cmmi10-2c\" transform=\"translate(2123.967389 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-79\" transform=\"translate(2171.652993 0.555573)\"/>\n     <use xlink:href=\"#Cmmi10-78\" transform=\"translate(2224.436197 -14.444389) scale(0.7)\"/>\n     <use xlink:href=\"#Cmr10-44\" transform=\"translate(2271.035518 0.555573)\"/>\n    </g>\n   </g>\n  </g>\n </g>\n <defs>\n  <clipPath id=\"p12d9ffc7b9\">\n   <rect x=\"-3.519422\" y=\"-53.808574\" width=\"835.2\" height=\"771.881588\"/>\n  </clipPath>\n </defs>\n</svg>"
