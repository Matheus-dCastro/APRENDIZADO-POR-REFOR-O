      "source": [
        "import os                                                                       # Verificação de arquivos\n",
        "import gdown                                                                    # Download de arquivos do Google Drive\n",
        "import gymnasium as gym                                                         # Ambientes de aprendizado por reforço\n",
        "from gymnasium.wrappers import RecordEpisodeStatistics                          # Estatísticas por episódio\n",
        "import numpy as np                                                              # Operações numéricas e vetoriais\n",
        "import pandas as pd                                                             # Tabelas de resultados\n",
        "import matplotlib.pyplot as plt                                                 # Gráficos\n",
        "from tqdm.auto import tqdm                                                      # Barra de progresso\n",
        "from typing import NamedTuple, Optional, List, Tuple                            # Anotações de tipo e tuplas nomeadas\n",
        "from collections import deque                                                   # Fila com tamanho máximo"
      ],
      "execution_count": null,
      "outputs": []
    },
