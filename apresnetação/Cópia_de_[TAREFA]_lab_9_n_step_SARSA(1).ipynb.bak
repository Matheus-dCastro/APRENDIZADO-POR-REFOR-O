              "           name=\"points\" min=\"0\" max=\"1\" step=\"1\" value=\"0\"\n",
              "           oninput=\"animf72bbd348d854c498603d1f019548ca7.set_frame(parseInt(this.value));\">\n",
              "    <div class=\"anim-buttons\">\n",
