              ".anim-state input {\n",
              "    margin: 0;\n",
              "    vertical-align: middle;\n",
              "}\n",
              "</style>\n",
              "\n",
              "<div class=\"animation\">\n",
              "  <img id=\"_anim_imgf72bbd348d854c498603d1f019548ca7\">\n",
              "  <div class=\"anim-controls\">\n",
