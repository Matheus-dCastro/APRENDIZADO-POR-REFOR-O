2 1844  Q 241 2122 305 2315  Q 369 2509 505 2668  Q 641 2828 844 2828  Q 1084 2828 1268 2676  Q 1453 2525 1453 2291  Q 1644 2541 1900 2684  Q 2156 2828 2444 2828  Q 2672 2828 2837 2750  Q 3003 2672 3095 2514  Q 3188 2356 3188 2138  Q 3188 1875 3070 1503  Q 2953 1131 2778 672  Q 2688 463 2688 288  Q 2688 97 2834 97  Q 3084 97 3251 365  Q 3419 634 3488 941  Q 3500 978 3541 978  L 3616 978  Q 3641 978 3658 962  Q 3675 947 3675 922  Q 3675 916 3669 903  Q 3581 541 3364 234  Q 3147 -72 2822 -72  Q 2597 -72 2437 83  Q 2278 238 2278 459  Q 2278 578 2328 709  Q 2409 919 2514 1209  Q 2619 1500 2686 1765  Q 2753 2031 2753 2234  Q 2753 2413 2679 2538  Q 2606 2663 2431 2663  Q 2197 2663 2000 2559  Q 1803 2456 1656 2286  Q 1509 2116 1388 1881  L 953 141  Q 931 53 854 -9  Q 778 -72 684 -72  Q 606 -72 550 -22  Q 494 28 494 109  z \" transform=\"scale(0.015625)\"/>\n     </defs>\n     <use xlink:href=\"#LMSans9-Regular-31\" transform=\"translate(0 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-74\" transform=\"translate(61.699936 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-32\" transform=\"translate(109.099884 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-4b\" transform=\"translate(154.799835 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-54\" transform=\"translate(236.399765 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-48\" transform=\"translate(289.49971 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-51\" transform=\"translate(313.99968 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-2c\" transform=\"translate(365.399628 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-67\" transform=\"translate(393.999603 0.59375)\"/>\n     <use xlink:href=\"#Cmmi10-7a\" transform=\"translate(428.299576 0.59375)\"/>\n     <use xlink:href=\"#Cmr10-29\" transform=\"translate(508.309399 0.59375)\"/>\n     <use xlink:href=\"#Cmr10-6e\" transform=\"translate(605.995003 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-67\" transform=\"translate(655.995003 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-32\" transform=\"translate(690.294975 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-67\" transform=\"translate(735.994926 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-6d\" transform=\"translate(770.294899 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-4b\" transform=\"translate(823.394844 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-67\" transform=\"translate(904.994774 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-32\" transform=\"translate(939.294746 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-54\" transform=\"translate(984.994698 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-42\" transform=\"translate(1038.094643 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-62\" transform=\"translate(1062.594612 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-1a6\" transform=\"translate(1101.994576 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-2f\" transform=\"translate(1153.394524 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-42\" transform=\"translate(1206.494469 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-51\" transform=\"translate(1230.994438 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-67\" transform=\"translate(1282.394386 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-2f\" transform=\"translate(1316.694359 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-32\" transform=\"translate(1369.794304 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-67\" transform=\"translate(1415.494255 0.59375)\"/>\n     <use xlink:href=\"#Cmmi10-78\" transform=\"translate(1449.794228 0.59375)\"/>\n     <use xlink:href=\"#Cmr10-29\" transform=\"translate(1528.192722 0.59375)\"/>\n     <use xlink:href=\"#Cmr10-78\" transform=\"translate(1625.878326 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-67\" transform=\"translate(1675.878326 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-54\" transform=\"translate(1710.178299 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-1c\" transform=\"translate(1763.278244 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-62\" transform=\"translate(1812.678192 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-62\" transform=\"translate(1852.078156 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-51\" transform=\"translate(1891.478119 0.59375)\"/>\n     <use xlink:href=\"#LMSans9-Regular-62\" transform=\"translate(1942.878067 0.59375)\"/>\n    </g>\n   </g>\n  </g>\n </g>\n <defs>\n  <clipPath id=\"pf95f4046c0\">\n   <rect x=\"-9.651064\" y=\"-12.284362\" width=\"820.8\" height=\"328.32\"/>\n  </clipPath>\n </defs>\n</svg>"
