anslate(512.98 0)\"/><use xlink:href=\"#LMSans10-Regular-193\" transform=\"translate(546.28 0)\"/><use xlink:href=\"#LMSans10-Regular-67\" transform=\"translate(624.08 0)\"/><use xlink:href=\"#LMSans10-Regular-48\" transform=\"translate(657.38 0)\"/><use xlink:href=\"#LMSans10-Regular-42\" transform=\"translate(681.28 0)\"/><use xlink:href=\"#LMSans10-Regular-4d\" transform=\"translate(705.19 0)\"/><use xlink:href=\"#LMSans10-Regular-3f\" transform=\"translate(756.89 0)\"/><use xlink:href=\"#LMSans10-Regular-1c\" transform=\"translate(808.59 0)\"/><use xlink:href=\"#LMSans10-Regular-67\" transform=\"translate(856.69 0)\"/><use xlink:href=\"#LMSans10-Regular-59\" transform=\"translate(889.98 0)\"/><use xlink:href=\"#LMSans10-Regular-67\" transform=\"translate(967.78 0)\"/><use xlink:href=\"#LMSans10-Regular-2b\" transform=\"translate(1001.08 0)\"/><use xlink:href=\"#LMSans10-Regular-51\" transform=\"translate(1045.48 0)\"/><use xlink:href=\"#LMSans10-Regular-48\" transform=\"translate(1095.48 0)\"/><use xlink:href=\"#LMSans10-Regular-6d\" transform=\"translate(1119.39 0)\"/><use xlink:href=\"#LMSans10-Regular-4d\" transform=\"translate(1171.09 0)\"/><use xlink:href=\"#LMSans10-Regular-1c\" transform=\"translate(1222.8 0)\"/></g></g><g id=\"patch_56\"><path d=\"M 684.89 114.25 C 685.56 114.25 686.21 114.51 686.69 114.99 C 687.16 115.47 687.43 116.11 687.43 116.79 C 687.43 117.46 687.16 118.11 686.69 118.59 C 686.21 119.06 685.56 119.33 684.89 119.33 C 684.21 119.33 683.57 119.06 683.09 118.59 C 682.61 118.11 682.35 117.46 682.35 116.79 C 682.35 116.11 682.61 115.47 683.09 114.99 C 683.57 114.51 684.21 114.25 684.89 114.25 z \" clip-path=\"url(#pbfbab6a137)\" style=\"fill: #1f4e9c; stroke: #1f4e9c; stroke-linejoin: miter\"/></g></g></g><defs><clipPath id=\"pbfbab6a137\"><rect x=\"10.8\" y=\"10.8\" width=\"758.88\" height=\"279.810503\"/></clipPath></defs></svg>"
          },
          "metadata": {}
