35 0)\"/><use xlink:href=\"#LMMono10-Regular-2f\" transform=\"translate(787.5 0)\"/><use xlink:href=\"#LMMono10-Regular-2d\" transform=\"translate(840 0)\"/><use xlink:href=\"#LMMono10-Regular-67\" transform=\"translate(892.5 0)\"/><use xlink:href=\"#LMMono10-Regular-69\" transform=\"translate(945 0)\"/><use xlink:href=\"#LMMono10-Regular-32\" transform=\"translate(997.5 0)\"/><use xlink:href=\"#LMMono10-Regular-60\" transform=\"translate(1050 0)\"/><use xlink:href=\"#LMMono10-Regular-4b\" transform=\"translate(1102.5 0)\"/><use xlink:href=\"#LMMono10-Regular-42\" transform=\"translate(1155 0)\"/><use xlink:href=\"#LMMono10-Regular-4d\" transform=\"translate(1207.5 0)\"/><use xlink:href=\"#LMMono10-Regular-1c\" transform=\"translate(1260 0)\"/><use xlink:href=\"#LMMono10-Regular-69\" transform=\"translate(1312.5 0)\"/><use xlink:href=\"#LMMono10-Regular-32\" transform=\"translate(1365 0)\"/><use xlink:href=\"#LMMono10-Regular-2f\" transform=\"translate(1417.5 0)\"/><use xlink:href=\"#LMMono10-Regular-2d\" transform=\"translate(1470 0)\"/><use xlink:href=\"#LMMono10-Regular-67\" transform=\"translate(1522.5 0)\"/><use xlink:href=\"#LMMono10-Regular-69\" transform=\"translate(1575 0)\"/><use xlink:href=\"#LMMono10-Regular-60\" transform=\"translate(1627.5 0)\"/><use xlink:href=\"#LMMono10-Regular-6d\" transform=\"translate(1680 0)\"/><use xlink:href=\"#LMMono10-Regular-4d\" transform=\"translate(1732.5 0)\"/><use xlink:href=\"#LMMono10-Regular-2b\" transform=\"translate(1785 0)\"/><use xlink:href=\"#LMMono10-Regular-1c\" transform=\"translate(1837.5 0)\"/><use xlink:href=\"#LMMono10-Regular-69\" transform=\"translate(1890 0)\"/><use xlink:href=\"#LMMono10-Regular-32\" transform=\"translate(1942.5 0)\"/><use xlink:href=\"#LMMono10-Regular-2f\" transform=\"translate(1995 0)\"/><use xlink:href=\"#LMMono10-Regular-2d\" transform=\"translate(2047.5 0)\"/><use xlink:href=\"#LMMono10-Regular-67\" transform=\"translate(2100 0)\"/><use xlink:href=\"#LMMono10-Regular-42\" transform=\"translate(2152.5 0)\"/><use xlink:href=\"#LMMono10-Regular-4d\" transform=\"translate(2205 0)\"/><use xlink:href=\"#LMMono10-Regular-37\" transform=\"translate(2257.5 0)\"/><use xlink:href=\"#LMMono10-Regular-51\" transform=\"translate(2310 0)\"/></g></g></g></g><defs><clipPath id=\"p870c7146ba\"><rect x=\"10.8\" y=\"10.8\" width=\"669.6\" height=\"155.232\"/></clipPath></defs></svg>"
