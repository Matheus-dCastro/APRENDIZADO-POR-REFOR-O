e(1011.96 0)\"/><use xlink:href=\"#Cmr10-28\" transform=\"translate(1109.64 0)\"/><use xlink:href=\"#Cmmi10-33\" transform=\"translate(1159.64 0)\"/><use xlink:href=\"#Cmr10-64\" transform=\"translate(1187.33 0)\"/><use xlink:href=\"#LMSans10-Regular-67\" transform=\"translate(1237.33 0)\"/><use xlink:href=\"#LMSans10-Regular-32\" transform=\"translate(1270.63 0)\"/><use xlink:href=\"#LMSans10-Regular-67\" transform=\"translate(1315.03 0)\"/><use xlink:href=\"#Cmsy10-2f\" transform=\"translate(1348.33 0)\"/><use xlink:href=\"#Cmsy10-5a\" transform=\"translate(1376.01 0)\"/><use xlink:href=\"#Cmr10-77\" transform=\"translate(1455.8 0)\"/><use xlink:href=\"#Cmmi10-58\" transform=\"translate(1494.62 0)\"/><use xlink:href=\"#Cmmi10-30\" transform=\"translate(1541.39 -15) scale(0.7)\"/><use xlink:href=\"#Cmr10-44\" transform=\"translate(1572.37 0)\"/><use xlink:href=\"#Cmsy10-2f\" transform=\"translate(1611.19 0)\"/><use xlink:href=\"#Cmr10-29\" transform=\"translate(1658.88 0)\"/><use xlink:href=\"#Cmr10-3b\" transform=\"translate(1756.56 0)\"/></g></g></g></g><defs><clipPath id=\"p5e9ca0fbdc\"><rect x=\"66.42\" y=\"33.7\" width=\"491.04\" height=\"199.584\"/></clipPath></defs></svg>"
          },
