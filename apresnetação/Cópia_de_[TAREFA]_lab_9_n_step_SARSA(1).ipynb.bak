e xlink:href=\"#LMSans9-Regular-60\" transform=\"translate(750.786308 0.59375)\"/>\n    </g>\n   </g>\n   <g id=\"text_27\">\n    <!-- sem  -->\n    <g style=\"fill: #6b6b6b\" transform=\"translate(662.912832 275.612234) scale(0.14 -0.14)\">\n     <use xlink:href=\"#LMSans9-Regular-62\"/>\n     <use xlink:href=\"#LMSans9-Regular-32\" transform=\"translate(39.40625 0)\"/>\n     <use xlink:href=\"#LMSans9-Regular-4b\" transform=\"translate(85.109375 0)\"/>\n     <use xlink:href=\"#LMSans9-Regular-67\" transform=\"translate(166.703125 0)\"/>\n    </g>\n   </g>\n   <g id=\"text_28\">\n    <!-- env.step -->\n    <g style=\"fill: #6b6b6b\" transform=\"translate(691.049082 275.220015) scale(0.14 -0.14)\">\n     <defs>\n      <path id=\"LMMono9-Regular-32\" d=\"M 2970 698  C 2970 832 2874 890 2733 890  C 2643 890 2560 890 2502 749  C 2349 384 1939 384 1869 384  C 1498 384 960 602 832 1210  L 2701 1210  C 2829 1210 2970 1210 2970 1453  C 2970 2195 2554 2810 1728 2810  C 947 2810 339 2157 339 1395  C 339 602 1005 -32 1824 -32  C 2682 -32 2970 544 2970 698  z M 2483 1619  L 838 1619  C 960 2144 1363 2394 1728 2394  C 2176 2394 2438 2099 2483 1619  z \" transform=\"scale(0.015625)\"/>\n      <path id=\"LMMono9-Regular-4d\" d=\"M 3302 205  C 3302 416 3130 416 3034 416  L 2752 416  L 2752 1869  C 2752 2502 2438 2790 1914 2790  C 1613 2790 1318 2682 1075 2470  C 1075 2650 1069 2758 806 2758  L 320 2758  C 230 2758 51 2758 51 2554  C 51 2342 224 2342 320 2342  L 602 2342  L 602 416  L 320 416  C 230 416 51 416 51 211  C 51 0 224 0 320 0  L 1357 0  C 1446 0 1626 0 1626 205  C 1626 416 1453 416 1357 416  L 1075 416  L 1075 1523  C 1075 2150 1562 2374 1875 2374  C 2189 2374 2278 2221 2278 1843  L 2278 416  L 2074 416  C 1984 416 1798 416 1798 211  C 1798 0 1978 0 2074 0  L 3034 0  C 3123 0 3302 0 3302 205  z \" transform=\"scale(0.015625)\"/>\n      <path id=\"LMMono9-Regular-70\" d=\"M 3200 2547  C 3200 2758 3027 2758 2925 2758  L 2170 2758  C 2080 2758 1894 2758 1894 2554  C 1894 23