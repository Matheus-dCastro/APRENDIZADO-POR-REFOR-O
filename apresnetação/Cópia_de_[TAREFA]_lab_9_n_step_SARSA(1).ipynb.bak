      },
      "source": [
        "## Funções auxiliares para visualização"
      ]
    },
    {
      "cell_type": "code",
      "id": "a6185c73cc37",
      "metadata": {
        "id": "a6185c73cc37"
      },
      "source": [
        "RL_UTILS_URL = \"https://drive.google.com/file/d/1AEJC-YWgeZCr8pZEOOiAg6PNK8IrBBRk/view?usp=sharing\"\n",
        "\n",
        "if not os.path.exists(\"rl_utils.py\"):                                           # Baixa o módulo só se ainda não existir\n",
        "    try:\n",
        "        gdown.download(RL_UTILS_URL, \"rl_utils.py\", quiet=True, fuzzy=True)\n",
        "    except Exception as error:\n",
        "        print(f\"Falha no download: {error}\")\n",
        "\n",
        "from rl_utils import (                                                          # Funções comuns aos labs da Unidade 2\n",
        "    plot_results, plot_comparison,                                              # Curvas de treinamento\n",
        "    simulate_trajectory, plot_trajectory,                                       # Trajetória sobre a grade\n",
        "    show_one_episode,                                                           # Animação de um episódio\n",
        "    plot_tabular, plot_policy_distributions,                                    # Mapas de calor de q, pi e v; barras pi(.|s)\n",
        "    show_figure, show_animation,                                                # Figuras e animação do laboratório\n",
        ")"
      ],
      "execution_count": null,
      "outputs": []
    },
